/*-one-pager-*.md
/*-sitrep-*.md

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Telegram authenticated-session files (credential-equivalent)
*.session
*.session-journal

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
