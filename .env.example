# strategic-analyst plugin — API credentials
#
# Copy this file to .env and fill in the keys you have. Missing keys are
# non-fatal: the SessionStart hook will print a warning per missing key,
# but skills that don't need the missing source continue to work.
#
# The .env file is gitignored. Do not commit it.

# ---------------------------------------------------------------------------
# Tier 1 — free, register-and-get-a-key (do these first)
# ---------------------------------------------------------------------------

# FRED — St. Louis Fed macro time series. Free, instant approval.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ACLED — armed conflict event data. Free with myACLED account.
# Register at https://acleddata.com/register; approval is automatic.
# In 2026 ACLED moved to OAuth 2.0 Bearer-token auth — the legacy static
# ACLED_KEY is no longer accepted. The skill exchanges email + password for
# a 24-hour access token at https://acleddata.com/oauth/token, caches it
# under cache/acled/token.json, and uses the 14-day refresh token for renewal.
#
# Migration from legacy: delete any ACLED_KEY=... line; set ACLED_PASSWORD
# to your myACLED login password. Keep ACLED_EMAIL unchanged.
# Docs: https://acleddata.com/acled-api-documentation
ACLED_EMAIL=
ACLED_PASSWORD=

# EIA — US Energy Information Administration. Free, instant.
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# UN Comtrade — bilateral trade data. Free tier; premium for bulk.
# https://comtradeplus.un.org/api/Subscription
COMTRADE_KEY=

# ENTSO-E — European power markets, transparency platform. Free with registration.
# https://transparency.entsoe.eu/usrm/user/createPublicUser
ENTSOE_API_KEY=

# NewsAPI — current articles, free tier 100/day. Paid tier ~£400/mo.
# https://newsapi.org/register
NEWSAPI_KEY=

# OpenSky Network — ADS-B aircraft data. Free for research use.
# https://opensky-network.org/
OPENSKY_USER=
OPENSKY_PASS=

# Alpha Vantage — equities/FX backup. Free with key.
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_KEY=

# OpenSanctions — entity-level sanctions resolution. Free tier; Pro is paid.
# https://www.opensanctions.org/api/
OPENSANCTIONS_KEY=

# Copernicus Data Space Ecosystem (Sentinel-1/2 imagery) — free, OAuth2 client
# credentials. Register at https://dataspace.copernicus.eu and create OAuth
# credentials at https://identity.dataspace.copernicus.eu/auth/realms/CDSE/account/
# Sentinel Hub uses the same env-var names with a different token endpoint.
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Telegram User API — free, ~3-min registration at https://my.telegram.org/apps
# Required only for the authenticated path of fetching-telegram-channels (channel
# history beyond ~20 posts, full-text search, media download). The unauthenticated
# t.me/s/<channel> path needs no credentials. The first authenticated run prompts
# for a phone number; the resulting .session file is a credential — gitignored.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# SEC EDGAR — no key needed, but the user-agent identifying the caller is
# required by EDGAR's terms of use. Format: "Project Name contact@email".
EDGAR_USER_AGENT="strategic-analyst your-email@example.com"

# ---------------------------------------------------------------------------
# Tier 2 — translation
# ---------------------------------------------------------------------------

# DeepL — paid Pro tier strongly recommended for stakes-grade analysis.
# Free tier is rate-limited. https://www.deepl.com/pro-api
DEEPL_API_KEY=

# ---------------------------------------------------------------------------
# Tier 3 — paid sources (only set if subscribed)
# ---------------------------------------------------------------------------

# Bloomberg — terminal install + B-PIPE/DAPI required. Token is for the API gateway.
BLOOMBERG_TOKEN=

# LSEG / Refinitiv (Eikon, News Direct API).
LSEG_REFINITIV_APP_KEY=

# Factiva — historical newspaper archive.
FACTIVA_USER=
FACTIVA_PASS=

# Janes — defence intelligence.
JANES_TOKEN=

# Kpler — vessel-level commodity flows.
KPLER_TOKEN=
KPLER_USER=

# Planet Labs — satellite imagery.
PLANET_API_KEY=

# Maxar — satellite imagery.
MAXAR_API_KEY=

# Lloyd's List Intelligence — maritime.
LLOYDS_LIST_TOKEN=

# S&P Global Platts — commodity pricing.
PLATTS_TOKEN=

# Argus — commodity pricing.
ARGUS_TOKEN=
